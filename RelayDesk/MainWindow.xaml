<Window x:Class="RelayDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RelayDesk 2.1 — Windows Multistream" Width="1260" Height="865"
        MinWidth="1050" MinHeight="690" Background="#0F1520" Foreground="#F8FAFC"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#192333"/>
        <SolidColorBrush x:Key="OutlineBrush" Color="#344255"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#304766"/>
            <Setter Property="Foreground" Value="#F3F6FA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#406287"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.65"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111C2A"/>
            <Setter Property="Foreground" Value="#EFF5FC"/>
            <Setter Property="BorderBrush" Value="#3D4E64"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <!-- Native WPF ComboBox uses a LIGHT selection surface: text must be dark. -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#F4F7FB"/>
            <Setter Property="Foreground" Value="#16253A"/>
            <Setter Property="BorderBrush" Value="#8296AB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="MinHeight" Value="35"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#F4F7FB"/>
            <Setter Property="Foreground" Value="#16253A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#CEE6F3"/>
                    <Setter Property="Foreground" Value="#0E2236"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BEE7E3"/>
                    <Setter Property="Foreground" Value="#0E2236"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Do not set a global TextBlock style: it forces white text inside
             light themed ComboBox controls and DataGrid column headers. -->
        <Style x:Key="ReadableHeader" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#293F59"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="#50637A"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ReadableCell" TargetType="{x:Type DataGridCell}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FAFCFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#23607C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReadableRow" TargetType="{x:Type DataGridRow}">
            <Setter Property="Foreground" Value="#FAFCFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="44"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="RELAYDESK 2.0" Foreground="#61E1C1" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="4K + Multi-Platform Streaming" FontSize="25" FontWeight="Bold" Margin="0,3,0,0"/>
                <TextBlock Text="Six platform presets • RTMP/RTMPS • NVIDIA NVENC • Independent streams"
                           Foreground="#AEBBCF" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartButton" Content="▶  START ALL" Background="#147D6C" Click="Start_Click"/>
                <Button x:Name="StopButton" Content="■  STOP ALL" Click="Stop_Click" IsEnabled="False" Margin="0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12"
                BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="OBS INPUT" FontSize="13" FontWeight="Bold" Foreground="#61E1C1"/>
                    <TextBlock Text="OBS → Settings → Stream → Custom..."
                               DockPanel.Dock="Right" Foreground="#A8B8CA" HorizontalAlignment="Right"/>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Server" FontSize="14" Foreground="#B5C1D1" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Copy" Click="CopyServer_Click" Margin="7,0,0,0"/>
                            <TextBox x:Name="SourceServerText" Text="rtmp://127.0.0.1:1935/live" IsReadOnly="True"/>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Stream key" FontSize="14" Foreground="#B5C1D1" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Copy" Click="CopySourceKey_Click" Margin="7,0,0,0"/>
                            <TextBox x:Name="SourceKeyText" Text="studio" IsReadOnly="True"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ENCODER" Foreground="#61E1C1"
                               VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" x:Name="EncoderBox" SelectionChanged="Encoder_Changed"/>
                    <TextBlock Grid.Column="3" x:Name="EgressText" Text="Configure destinations to estimate upload bandwidth."
                               Foreground="#B8C8DB" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="12"
                BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,11">
                    <TextBlock Text="DESTINATIONS" FontSize="13" FontWeight="Bold" Foreground="#61E1C1"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="AddSixButton" Content="+ Add Six" Click="AddSix_Click"/>
                        <Button x:Name="AddButton" Content="+ Add" Click="Add_Click"/>
                        <Button x:Name="EditButton" Content="Edit" Click="Edit_Click"/>
                        <Button x:Name="RemoveButton" Content="Remove" Click="Remove_Click"/>
                        <Button x:Name="StartSelectedButton" Content="▶ Selected" Click="StartSelected_Click"/>
                        <Button x:Name="StopSelectedButton" Content="■ Selected" Click="StopSelected_Click"/>
                        <Button x:Name="SaveButton" Content="Save" Click="Save_Click" Margin="0"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid Grid.Row="1" x:Name="TargetsGrid" AutoGenerateColumns="False"
                          ColumnHeaderStyle="{StaticResource ReadableHeader}"
                          CellStyle="{StaticResource ReadableCell}" RowStyle="{StaticResource ReadableRow}"
                          Background="#111C2A" Foreground="#EAF0F9" RowBackground="#152132"
                          AlternatingRowBackground="#1A293A" GridLinesVisibility="None"
                          BorderThickness="0" HeadersVisibility="Column" CanUserAddRows="False"
                          CanUserDeleteRows="False" SelectionMode="Single" IsReadOnly="False"
                          SelectionChanged="TargetsGrid_SelectionChanged"
                          ColumnHeaderHeight="42" RowHeight="45" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="47"/>
                        <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Destination" Binding="{Binding Name}" Width="1.4*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Output" Binding="{Binding ProfileLabel}" Width="1.45*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.6*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Actual bitrate" Binding="{Binding Bitrate}" Width="1*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="12"
                BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,9">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ACTIVITY • SENDING IS NOT PLATFORM CONFIRMATION"
                           FontWeight="Bold" FontSize="14" Foreground="#61E1C1" Margin="0,0,0,7"/>
                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4">
            <TextBlock x:Name="StateText" Text="Idle • Local RTMP input: 127.0.0.1:1935"
                       Foreground="#B1BED1"/>
            <TextBlock DockPanel.Dock="Right" Text="OBS → MediaMTX → FFmpeg → Live platforms"
                       Foreground="#8394A9" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
